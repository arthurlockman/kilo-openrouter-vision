{
  "name": "kilo-openrouter-vision",
  "version": "0.1.8",
  "description": "Kilo plugin that describes pasted images with OpenRouter for text-only models.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./tui": {
      "import": "./dist/tui.js",
      "default": "./dist/tui.js"
    }
  },
  "files": [
    "dist/index.js",
    "dist/index.d.ts",
    "dist/tui.js",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && npm run build:tui",
    "build:tui": "node scripts/build-tui.mjs && esbuild dist/tui.esm.js --bundle --format=esm --platform=node --external:solid-js --external:@opentui/solid --external:@opentui/core --outfile=dist/tui.js --sourcemap=inline && node -e \"require('node:fs').rmSync('dist/tui.esm.js',{force:true})\"",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tui.json",
    "check": "npm run typecheck && npm test && npm run build",
    "prepack": "npm run check"
  },
  "keywords": [
    "kilo",
    "kilocode",
    "openrouter",
    "vision",
    "plugin"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arthurlockman/kilo-openrouter-vision.git"
  },
  "bugs": {
    "url": "https://github.com/arthurlockman/kilo-openrouter-vision/issues"
  },
  "homepage": "https://github.com/arthurlockman/kilo-openrouter-vision#readme",
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@kilocode/plugin": ">=7.3.1 <8"
  },
  "devDependencies": {
    "@kilocode/plugin": "7.3.1",
    "@kilocode/sdk": "7.3.1",
    "@types/node": "^22.17.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@opentui/core": "^0.5.1",
    "@opentui/solid": "^0.5.1",
    "opentui-spinner": "^0.0.7",
    "solid-js": "^1.9.12"
  }
}
